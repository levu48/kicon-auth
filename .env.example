# Copy to .env for local dev:  cp .env.example .env

NODE_ENV=development
PORT=3000

# Public issuer. Discovery is served at ${ISSUER}/.well-known/openid-configuration.
# PROD (per CLAUDE.md): the BARE origin https://auth.kicon.com — never a parent-domain.
ISSUER=http://localhost:3000

# Cookie signing keys, comma-separated (first is primary; rest allow rotation).
# DEV ONLY. PROD: load from a secret store, never commit. See CLAUDE.md.
COOKIE_KEYS=dev-insecure-key-1,dev-insecure-key-2

# Token-signing keystore (private ES256 JWKS). Dev auto-generates a persistent
# file here; PROD must mount a real one (never committed). Manage with
# `npm run keys:init|list|rotate`. JWKS_KEEP caps retained keys after rotation.
JWKS_PATH=./secrets/jwks.json
# JWKS_KEEP=3

# Login hardening (Redis-backed). Defaults shown.
# LOGIN_IP_WINDOW=60                 # per-IP attempt window (seconds)
# LOGIN_IP_MAX=20                    # max attempts per IP per window
# LOGIN_ACCOUNT_MAX_FAILURES=5       # bad passwords before account lockout
# LOGIN_LOCKOUT_SECONDS=900          # lockout duration

# IdP identity DB + Redis (sessions/tokens/codes/grants). The IdP connects ONLY
# to its own database — never an application's (see docs/data-ownership.md).
# Local Homebrew Postgres example (adjust user); docker-compose uses kicon:kicon.
DATABASE_URL=postgres://kicon:kicon@localhost:5432/kicon_idp
REDIS_URL=redis://localhost:6379
