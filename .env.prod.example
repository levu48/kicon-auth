# Production environment template. Copy to .env.prod ON THE DROPLET and fill in
# real values from your secret store. NEVER commit .env.prod. (.env* is gitignored.)

NODE_ENV=production
PORT=3000

# The public issuer — the bare origin, TLS, per CLAUDE.md. Everything derives from this.
ISSUER=https://auth.kicon.com

# Cookie signing keys (comma-separated; first is primary, rest allow rotation).
# Generate strong random values; store in a secret manager, not here.
COOKIE_KEYS=REPLACE_WITH_TWO_RANDOM_SECRETS_COMMA_SEPARATED

# Managed Postgres (DigitalOcean). Use the private-network host + require TLS.
DATABASE_URL=postgres://USER:PASSWORD@PRIVATE_DB_HOST:25060/kicon_idp?sslmode=require

# Managed Redis (DigitalOcean). rediss:// = TLS.
REDIS_URL=rediss://default:PASSWORD@PRIVATE_REDIS_HOST:25061

# Signing keystore (private ES256 JWKS). Mounted read-only into the container at
# this path from ./secrets/jwks.json on the droplet (see docker-compose.prod.yml).
JWKS_PATH=/app/secrets/jwks.json
# JWKS_KEEP=3

# ─── Confidential client secrets (REQUIRED in production) ────────────────────
# One per confidential client. The IdP REFUSES TO BOOT in production if any is
# missing or still contains "CHANGE-ME" — a booting IdP with a known secret looks
# healthy while being wide open, so it fails loudly instead. See
# docs/client-secrets.md for the rotation runbook (each value must also be
# updated in the client that presents it, in the same window).
#
# Generate each with:  openssl rand -base64 48
CLIENT_SECRET_VIETCOUNCIL=REPLACE_ME
CLIENT_SECRET_XBOTTRADER=REPLACE_ME
CLIENT_SECRET_VOTE_BRIDGE=REPLACE_ME
CLIENT_SECRET_SURVEY_BRIDGE=REPLACE_ME

# Login hardening (defaults are sensible; tune as needed).
# LOGIN_IP_WINDOW=60
# LOGIN_IP_MAX=20
# LOGIN_ACCOUNT_MAX_FAILURES=5
# LOGIN_LOCKOUT_SECONDS=900
