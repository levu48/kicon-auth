{
  "name": "auth-kicon-idp",
  "version": "0.1.0",
  "private": true,
  "description": "auth.kicon.com — OpenID Connect identity provider (NestJS + oidc-provider). Phase 1 scaffold.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run:prod": "typeorm migration:run -d dist/database/data-source.js",
    "keys:init": "ts-node -T src/oidc/keys/cli.ts init",
    "keys:list": "ts-node -T src/oidc/keys/cli.ts list",
    "keys:rotate": "ts-node -T src/oidc/keys/cli.ts rotate"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/typeorm": "^10.0.2",
    "argon2": "^0.41.1",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "oidc-provider": "^8.5.3",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.10",
    "@types/oidc-provider": "^8.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
